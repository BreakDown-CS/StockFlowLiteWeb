# ---------------------------------------------------------------------------
# SERVER-ONLY values.
# NEVER prefix these with NEXT_PUBLIC_ : Next inlines NEXT_PUBLIC_* into the
# browser bundle at build time, which would leak secrets to every visitor.
# ---------------------------------------------------------------------------

# Go API base URL (server-to-server only). No trailing slash.
BACKEND_API_URL=http://127.0.0.1:8080

# Exact public origin of this app. Used for the CSRF origin allowlist.
APP_ORIGIN=http://localhost:3000

# AES-256-GCM key material for the session cookie. Min 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-32-plus-random-characters

# Optional. Defaults to `NODE_ENV === 'production'`:
#   - development (plain HTTP on loopback) -> false, so the cookie works;
#   - next build / next start              -> true, never silently insecure.
# Setting it to "false" while NODE_ENV=production is rejected at boot.
# SESSION_COOKIE_SECURE=false

# Upstream request timeout (ms).
BACKEND_TIMEOUT_MS=10000

# BFF-side login throttling (defence in depth; the API has its own limiter).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Default window applied by the report screens when the user picks no range.
DEFAULT_REPORT_RANGE_DAYS=30

# ---------------------------------------------------------------------------
# PUBLIC values (safe to inline into the client bundle).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=StockFlow Lite
